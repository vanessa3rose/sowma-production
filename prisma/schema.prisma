generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SocialMedia {
  id              String               @id @default(cuid())
  provider        Provider
  userId          String
  username        String
  displayName     String?
  profileUrl      String?
  email           String?
  SocialMediaAuth SocialMediaAuth?
  metrics         SocialMediaMetrics[]
}

model SocialMediaMetrics {
  id            String      @id @default(cuid())
  socialMediaId String
  metricName    Metric
  metricValue   Int
  lastSynced    DateTime?
  socialMedia   SocialMedia @relation(fields: [socialMediaId], references: [id])
  metricDate    DateTime?
  breakdownKey  String?
  breakdownValue String?
}

model SocialMediaAuth {
  id            String      @id @default(cuid())
  socialMediaId String      @unique
  accessToken   String
  refreshToken  String?
  expiresAt     DateTime?
  lastRefreshed DateTime?
  socialMedia   SocialMedia @relation(fields: [socialMediaId], references: [id])
}

model DatabaseReport {
  id         String                @id @default(cuid())
  reportDate DateTime
  counts     DatabaseReportCount[]
}

model DatabaseReportCount {
  id       String         @id @default(cuid())
  reportId String
  count    Count
  value    Int            @default(0)
  report   DatabaseReport @relation(fields: [reportId], references: [id])

  @@unique([reportId, count])
}

model User {
  email     String @id        // Required
  firstName String            // Required
  lastName  String            // Required
  password  String            // Required
  role      Role              // Required
}

enum Role {
  ADMIN
  INTERN
}

enum Provider {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  LINKEDIN
  TWITTER
  GOOGLE_ANALYTICS
}

enum Metric {
  FOLLOWERS
  LIKES
  SHARES
  COMMENTS
  VIEWS
  POSTS
  ACTIVE_USERS
  SCREEN_PAGE_VIEWS
  ACTIVE_7_DAY_USERS
  ENGAGEMENT_RATE
  NEW_USERS
  BOUNCE_RATE 
  AVG_SESSION_DURATION
  PAGES_PER_SESSION
  TOTAL_USERS
  DAYS_POSTED
  TOTAL_SESSIONS
  ENGAGED_SESSIONS
  ENGAGEMENT_TIME
  SESSIONS_BY_SOURCE
}

enum Count {
  ATTENDED_EVENT
  COMMUNITY_VOLUNTEER
  CORPORATE_VOLUNTEER
  GOOGLE_SEARCH
  HEARD_SOWMA_SPEAKER
  NEWS_MEDIA
  OTHER
  REFERRAL
  SCHOOL_VOLUNTEER
  SOCIAL_MEDIA
  WEBSITE
}
