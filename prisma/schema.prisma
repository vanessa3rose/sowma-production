generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SocialMedia {
  id          String               @id @default(cuid())
  provider    Provider
  userId      String
  username    String
  displayName String?
  profileUrl  String?
  email       String?
  metrics     SocialMediaMetrics[]
}

model SocialMediaMetrics {
  id            String      @id @default(cuid())
  socialMediaId String
  metricName    Metric
  metricValue   Int
  lastSynced    DateTime?
  socialMedia   SocialMedia @relation(fields: [socialMediaId], references: [id])
}

model DatabaseReport {
  id         String                @id @default(cuid())
  reportDate DateTime
  counts     DatabaseReportCount[]
}

model DatabaseReportCount {
  id       String         @id @default(cuid())
  reportId String
  count    Count
  value    Int            @default(0)
  report   DatabaseReport @relation(fields: [reportId], references: [id])

  @@unique([reportId, count])
}

enum Provider {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  LINKEDIN
  TWITTER
}

enum Metric {
  FOLLOWERS
  LIKES
  SHARES
  COMMENTS
  VIEWS
  POSTS
}

enum Count {
  ATTENDED_EVENT
  COMMUNITY_VOLUNTEER
  CORPORATE_VOLUNTEER
  GOOGLE_SEARCH
  HEARD_SOWMA_SPEAKER
  NEWS_MEDIA
  OTHER
  REFERRAL
  SCHOOL_VOLUNTEER
  SOCIAL_MEDIA
  WEBSITE
}
