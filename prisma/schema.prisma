generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SocialMedia {
  id          String               @id @default(cuid())
  provider    Provider
  userId      String
  username    String
  displayName String?
  profileUrl  String?
  email       String?
  metrics     SocialMediaMetrics[]
}

model SocialMediaMetrics {
  id            String      @id @default(cuid())
  socialMediaId String
  metricName    Metric
  metricValue   Int
  lastSynced    DateTime?
  socialMedia   SocialMedia @relation(fields: [socialMediaId], references: [id])
}

enum Provider {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  LINKEDIN
  TWITTER
}

enum Metric {
  FOLLOWERS
  LIKES
  SHARES
  COMMENTS
  VIEWS
}
